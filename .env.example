# ============================================================
# NCGA — copy this to .env and fill values. .env is .gitignore'd.
# ============================================================

# --- Required: LLM access ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# --- Optional LLM tuning ---
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_STREAM=true
# LLM_TIMEOUT_SECONDS=60

# --- Server ---
# NCGA_HOST=127.0.0.1            # use 0.0.0.0 only behind a TLS reverse proxy
# NCGA_PORT=8000
# NCGA_LOG_LEVEL=INFO

# --- Limits ---
# NCGA_RATE_LIMIT_PER_MIN=30
# NCGA_BATCH_RATE_LIMIT_PER_MIN=6
# NCGA_MAX_BODY_BYTES=65536

# --- Cycle 13: SECURITY ---
# Bearer-token auth: when set, all POST /api/* require Authorization: Bearer <token>.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# NCGA_AUTH_TOKEN=

# AES-GCM key for at-rest encryption of the quality store.
# Generate: python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# If unset, a key is auto-generated under ~/.local/share/ncga/data.key (mode 0600).
# NCGA_DATA_KEY=

# Trust X-Forwarded-For header for client IP? Default false (prevents per-IP rate-limit
# spoofing). Set to true ONLY when behind a trusted reverse proxy.
# NCGA_TRUST_FORWARDED_FOR=false

# Custom path for the quality store. Default: ~/.local/share/ncga/quality.json
# (or $XDG_DATA_HOME/ncga/quality.json if set).
# NCGA_QUALITY_STORE=

# --- Cycle 20: feedback + per-IP daily LLM ceiling ---
# NCGA_FEEDBACK_RATE_LIMIT_PER_MIN=5    # POST /api/feedback per IP per minute
# NCGA_FEEDBACK_MAX_BODY_BYTES=8192
# NCGA_FEEDBACK_STORE=                  # default ~/.local/share/ncga/feedback.jsonl (0o600)
# NCGA_DAILY_LLM_CAP_PER_IP=            # shared daily cap across rewrite/batch/rate/explain/characterize/phrase
# NCGA_CHARACTERIZE_RATE_LIMIT_PER_MIN=
# NCGA_CHARACTERIZE_MAX_BODY_BYTES=

# --- Cycle 22: few-shot corpus + word-level lexicon injection ---
# Both are ON by default (data ships in data/corpus.jsonl + data/lexicon.jsonl).
# NCGA_CORPUS_PATH=                     # override corpus JSONL path
# NCGA_CORPUS_DISABLE=                  # set to 1 to turn OFF sentence few-shot injection
# NCGA_LEXICON_PATH=                    # override lexicon JSONL path
# NCGA_LEXICON_DISABLE=                 # set to 1 to turn OFF word-level hint injection

# --- Lifecycle ---
# NCGA_PID_FILE=                        # default .ncga.pid in the repo root

# --- DANGEROUS — only for local debugging behind a corporate proxy ---
# LLM_SKIP_SSL_VERIFY=false
# LLM_CA_BUNDLE=
