{
  "manifest_version": 3,
  "name": "地道中文 · NCGA",
  "version": "0.1.0",
  "description": "Rewrite selected text into 10 Chinese regional varieties via your local NCGA server. Right-click any selection → 改写为... Token stored encrypted via Web Crypto.",
  "default_locale": "zh_CN",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "contextMenus",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_title": "地道中文 · 设置 / 选方言",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],

  "minimum_chrome_version": "116"
}
